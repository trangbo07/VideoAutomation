# Sao chép thành .env (hoặc đặt trên Vercel: Settings -> Environment Variables)

# Khóa bí mật ký vé render (Ed25519, pkcs8/der, base64). KHÔNG chia sẻ, KHÔNG commit.
LICENSE_PRIVATE_KEY=

# Mật khẩu đăng nhập trang quản trị /admin.html. Đặt một chuỗi dài ngẫu nhiên.
ADMIN_TOKEN=

# Upstash Redis — tự có khi gắn integration Upstash trên Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
